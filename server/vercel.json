{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "index.py": {
      "maxDuration": 120,
      "excludeFiles": "{tests/**,migrations/**,deploy/**,*.db,openapi.json}"
    }
  },
  "crons": [
    {
      "path": "/v1/cron/purge-purchase-records",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/v1/cron/marketing-reconfirm",
      "schedule": "0 1 * * *"
    }
  ]
}
