<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Youniya" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg_canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- AN-01: the system splash shows the 01 Logo Mark on bg/canvas. -->
    <style name="Theme.Youniya.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Youniya</item>
    </style>
</resources>
